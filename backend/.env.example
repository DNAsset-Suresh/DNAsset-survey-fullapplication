SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Prefer sb_secret_...; legacy service_role is also supported below.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=land-documents
PORT=3000
MAX_FILE_SIZE_MB=20
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:3000
# Set only to the verified number of reverse proxy hops for your deployment.
TRUST_PROXY_HOPS=0
# Optional absolute server path to a licensed Unicode .ttf/.otf for non-Latin PDF text.
PDF_FONT_PATH=

# Local PostgreSQL database mode (set to true to use embedded Postgres)
USE_LOCAL_DB=true
# USE_LOCAL_DB=true takes precedence over DATABASE_URL.
DATABASE_URL=
PGSSLROOTCERT=
LOCAL_DATABASE_FILE=
LOCAL_STORAGE_DIRECTORY=
# Retain historical file bytes unless an administrator explicitly enables cleanup.
STORAGE_CLEANUP_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false

# Email Notifications & Report Delivery
ADMIN_NOTIFICATION_EMAIL=your_admin_email@example.com
ADMIN_EMAIL=your_admin_email@example.com
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_PASS=your_smtp_password
SMTP_FROM="DNAssets Survey <your_smtp_username>"

# Back up application data and known stored objects before confirmed admin deletion/reset.
SURVEY_BACKUP_ENABLED=true
SURVEY_BACKUP_DIRECTORY=backups/operations

# Firebase Configuration
USE_FIREBASE=false
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
